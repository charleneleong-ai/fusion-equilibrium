# Copy to .env (gitignored). Both machines are already logged in to W&B and Hugging Face via ~/.netrc / hf auth.
# Only set a variable here to override that; leave lines commented rather than empty (an empty value shadows the login).
WANDB_PROJECT=fusion-equilibrium
WANDB_ENTITY=chaleong
# WANDB_API_KEY=
# WANDB_MODE=disabled
# HF_TOKEN=            write token for pushing predictions (or `huggingface-cli login`)
# HF_READ_TOKEN=       fine-grained READ token scoped to chaleong/fusion-eq-predictions; goes into the pointer zip
